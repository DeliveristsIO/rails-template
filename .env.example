# Copy to .env and fill in. Never commit .env — it is gitignored.
#
# Everything here is optional. An install with none of it set is a working
# free product rather than a broken paid one: Stripe unconfigured takes nothing
# off sale that was ever on it, Turnstile unconfigured admits everybody, and
# Sentry unconfigured reports nowhere.

# --- Database (development/test) ---
# Defaults match a local postgres on 5432 with the postgres/postgres superuser.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# --- Payments ---
# STRIPE_WEBHOOK_SECRET is what a payment is actually believed on — the success
# redirect unlocks nothing. Take it from the endpoint you create at
# https://dashboard.stripe.com/webhooks pointed at POST /webhooks/stripe,
# subscribed to four events: checkout.session.completed,
# customer.subscription.created, customer.subscription.updated and
# customer.subscription.deleted. Without the last three a subscription is
# charged and the account stays on the free ceilings.
#
# A key beginning sk_live_ takes real money. Staging wants a test key.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=eur

# The monthly tiers, in the smallest currency unit. Unset, they are the numbers
# in app/models/plan.rb. With no STRIPE_SECRET_KEY nothing is on sale at all,
# every account is on the free plan, and the free plan's ceilings are exactly
# what the product enforced before there were plans.
PLAN_STARTER_CENTS=900
PLAN_TEAM_CENTS=2900
PLAN_BUSINESS_CENTS=7900

# --- Bot challenge ---
# Cloudflare Turnstile, the one defence that survives a rotating address: rate
# limits ask how much a caller has spent, which a VPN or a fresh private window
# makes meaningless. Unset, the widget renders nothing and every form behaves
# as it does without it.
#
# For local work use Cloudflare's published testing keys rather than a real
# pair — they need no dashboard and never call a live challenge:
#   always passes: 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
#   always fails:  2x00000000000000000000AB / 2x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Error tracking ---
SENTRY_DSN=

# --- Outbound mail ---
# The envelope sender. It has to be on a domain the relay is authorised for or
# the relay refuses it.
MAIL_FROM=
