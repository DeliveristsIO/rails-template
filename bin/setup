#!/usr/bin/env bash
# Idempotent development setup. Safe to re-run after every pull.
set -euo pipefail

cd "$(dirname "$0")/.."

say() { printf "\n▸ %s\n" "$1"; }

if ! command -v mise >/dev/null 2>&1; then
  say "mise not found"
  echo "  Install it (https://mise.jdx.dev) so ruby matches .mise.toml, then re-run."
  exit 1
fi

say "Toolchain (.mise.toml)"
mise install

say "Environment file"
if [ ! -f .env ]; then
  cp .env.example .env
  echo "  Created .env from .env.example — everything in it is optional."
else
  echo "  .env already present, leaving it alone."
fi

say "Ruby dependencies"
bundle check >/dev/null 2>&1 || bundle install

say "JavaScript dependencies"
# The app is importmap-based and tailwindcss-ruby ships a standalone binary, so
# there is normally no package.json at all. Kept for the day one appears.
if [ -f package.json ]; then
  if command -v bun >/dev/null 2>&1; then bun install; else npm install; fi
else
  echo "  No package.json (importmap + standalone tailwind), nothing to install."
fi

say "Database"
# db:prepare creates the database when it is missing and migrates it otherwise,
# so the same command covers a first checkout and a routine pull.
bin/rails db:prepare

say "Clearing logs and temp files"
bin/rails log:clear tmp:clear

say "Ready"
cat <<'MSG'
  bin/dev      start the app (web + css + jobs)
  bin/ci       the full check suite — run before every push
  bin/shot     screenshot a URL with headless Chrome
MSG
