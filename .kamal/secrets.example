# Copy to .kamal/secrets (gitignored) and fill in, or source from a secret
# manager with Kamal's `$(...)` interpolation. Never commit real values.
#
# Per-destination overrides go in .kamal/secrets.staging and
# .kamal/secrets.production, which are gitignored for the same reason.
KAMAL_REGISTRY_PASSWORD=
RAILS_MASTER_KEY=
SECRET_KEY_BASE=
DATABASE_URL=
POSTGRES_PASSWORD=
SENTRY_DSN=
# The Flipper UI is behind HTTP basic auth because it can switch parts of the
# product off for every visitor.
FLIPPER_USERNAME=
FLIPPER_PASSWORD=
# Stripe. sk_live_ takes real money — staging wants a test key.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Outbound mail relay.
SMTP_USERNAME=
SMTP_PASSWORD=
# Cloudflare Turnstile's secret half. The site key is public and lives in
# config/deploy.*.yml; this one does not. Both or neither — with only one set
# the challenge stays off.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
