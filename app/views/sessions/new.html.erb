<% content_for :title, t("sessions.new.title") %>

<main class="mx-auto flex max-w-md flex-col justify-center px-6 py-24">
  <h1 class="text-4xl font-semibold tracking-tight"><%= t("sessions.new.heading") %></h1>
  <p class="mt-3 leading-relaxed text-ink-600"><%= t("sessions.new.body") %></p>

  <%= form_with url: sign_in_path, class: "mt-10 space-y-5" do |form| %>
    <%= hidden_field_tag :return_to, params[:return_to] %>

    <% if flash.now[:alert].present? %>
      <p class="rounded-lg bg-state-bad/10 px-4 py-3 text-sm text-state-bad"><%= flash.now[:alert] %></p>
    <% end %>

    <div>
      <%= form.label :email_address, t("accounts.email"), class: "block text-sm text-ink-600" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "email",
            value: params[:email_address],
            class: "mt-2 w-full rounded-lg border border-ink-200 bg-white px-4 py-3 outline-none transition focus:border-ink-900" %>
    </div>

    <div>
      <%= form.label :password, t("accounts.password"), class: "block text-sm text-ink-600" %>
      <%= form.password_field :password, required: true, autocomplete: "current-password",
            class: "mt-2 w-full rounded-lg border border-ink-200 bg-white px-4 py-3 outline-none transition focus:border-ink-900" %>
    </div>

    <%= form.submit t("sessions.new.submit"),
          class: "w-full cursor-pointer rounded-xl bg-ink-900 px-6 py-4 font-medium text-paper transition hover:bg-ink-800" %>
  <% end %>

  <p class="mt-6 text-sm text-ink-400">
    <%= t("sessions.new.no_account") %>
    <%= link_to t("sessions.new.sign_up"), sign_up_path, class: "text-ink-900 underline underline-offset-4" %>
  </p>
</main>
