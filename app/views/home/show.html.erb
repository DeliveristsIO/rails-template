<%# TEMPLATE: the first screen to throw away. It exists so a freshly generated
    app boots into something that proves the stack is wired — type, tokens,
    locale switch, session state — rather than into the Rails welcome page. %>
<main class="mx-auto max-w-6xl px-6 py-20 sm:py-28">
  <p class="font-mono text-xs tracking-[0.2em] text-ink-400 uppercase"><%= t("home.hero.eyebrow") %></p>

  <h1 class="mt-6 max-w-[16ch] text-display font-semibold text-balance">
    <%= t("home.hero.heading") %>
  </h1>

  <p class="mt-7 max-w-[58ch] text-xl leading-relaxed text-ink-600 text-balance">
    <%= t("home.hero.body") %>
  </p>

  <div class="mt-10 flex flex-wrap items-center gap-3">
    <% if authenticated? %>
      <%= link_to t("home.hero.plan_cta"), subscription_path,
            class: "rounded-xl bg-ink-900 px-6 py-4 font-medium text-paper transition hover:bg-ink-800" %>
    <% else %>
      <%= link_to t("home.hero.cta"), sign_up_path,
            class: "rounded-xl bg-ink-900 px-6 py-4 font-medium text-paper transition hover:bg-ink-800" %>
    <% end %>
    <%= link_to t("home.hero.secondary_cta"), "https://github.com/DeliveristsIO/rails-template", rel: "noopener",
          class: "rounded-xl px-6 py-4 font-medium text-ink-600 ring-1 ring-ink-200 transition hover:bg-white" %>
  </div>

  <%# What is already wired, so the first thing anyone reads is what they do
      not have to build. Each row names the file it is talking about. %>
  <section class="mt-24 border-t border-ink-100 pt-12">
    <h2 class="text-2xl font-medium tracking-tight"><%= t("home.included.heading") %></h2>

    <dl class="mt-8 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
      <% %w[ auth billing i18n limits ci deploy ].each do |feature| %>
        <div>
          <dt class="font-medium"><%= t("home.included.#{feature}.name") %></dt>
          <dd class="mt-2 max-w-[42ch] text-sm leading-relaxed text-ink-600">
            <%= t("home.included.#{feature}.body") %>
          </dd>
          <dd class="mt-2 font-mono text-xs text-ink-400"><%= t("home.included.#{feature}.where") %></dd>
        </div>
      <% end %>
    </dl>
  </section>

  <section class="mt-20 border-t border-ink-100 pt-12">
    <h2 class="text-2xl font-medium tracking-tight"><%= t("home.next.heading") %></h2>

    <ol class="mt-8 max-w-3xl divide-y divide-ink-100 border-y border-ink-100">
      <% %w[ rename tokens plan strip ].each_with_index do |step, index| %>
        <li class="flex gap-5 py-5">
          <span class="font-mono text-xs text-ink-300 tabular-nums"><%= format("%02d", index + 1) %></span>
          <span class="text-sm leading-relaxed text-ink-600"><%= t("home.next.#{step}") %></span>
        </li>
      <% end %>
    </ol>
  </section>
</main>
